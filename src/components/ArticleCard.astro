---
interface Props {
  href: string;
  title: string;
  description: string;
  category: string;
  readingTime: string;
}
const { href, title, description, category, readingTime } = Astro.props;
---
<article class="article-card">
  <div class="article-card__meta"><span>{category}</span><span>{readingTime}</span></div>
  <h3><a href={href}>{title}</a></h3>
  <p>{description}</p>
  <a class="text-link" href={href}>Ler artigo <span aria-hidden="true">↗</span></a>
</article>
