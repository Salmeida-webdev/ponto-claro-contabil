---
interface Props {
  number: string;
  title: string;
  description: string;
}
const { number, title, description } = Astro.props;
---
<article class="service-card">
  <span class="service-card__number" aria-hidden="true">{number}</span>
  <div>
    <h3>{title}</h3>
    <p>{description}</p>
  </div>
  <a class="text-link" href="/contato/" aria-label={`Conversar sobre ${title}`}>
    Conversar sobre este serviço <span aria-hidden="true">↗</span>
  </a>
</article>
