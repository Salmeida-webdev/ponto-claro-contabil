---
interface Props {
  eyebrow: string;
  title: string;
  text?: string;
  centered?: boolean;
}
const { eyebrow, title, text, centered = false } = Astro.props;
---
<div class:list={["section-heading", centered && "section-heading--center"]}>
  <p class="eyebrow">{eyebrow}</p>
  <h2>{title}</h2>
  {text && <p class="section-heading__text">{text}</p>}
</div>
